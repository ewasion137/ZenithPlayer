{
  "name": "zenith",
  "version": "2.3.2",
  "description": "Music player made on Electron.",
  "main": "Zenith/script/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ewasion137.zenith",
    "productName": "Zenith",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/yt-dlp-wrap/**"
    ],
    "files": [
      "Zenith/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/*/{README.md,CHANGELOG.md,LICENSE,test,tests,docs,example,examples}",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "Zenith/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "Zenith/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "music-metadata": "^7.14.0", 
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  }
}